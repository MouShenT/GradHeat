# 数据库连接（经 SSH 隧道到 VM）
#
# 先建隧道，否则连不上：
#   ssh -N -L 13306:127.0.0.1:3306 -L 16379:127.0.0.1:6379 ms@192.168.43.150
#
# 密码取法：VM 上 /opt/gradheat/infra/docker/.env 的 MYSQL_PASSWORD
GRADHEAT_DB_HOST=127.0.0.1
GRADHEAT_DB_PORT=13306
GRADHEAT_DB_NAME=gradheat
GRADHEAT_DB_USER=gradheat
GRADHEAT_DB_PASSWORD=