{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GradHeat release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "snapshot_id", "analysis_version", "capability", "mode", "cutoff", "generated_at", "evidence", "checks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "release_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "analysis_version": {"type": "string", "minLength": 1},
    "capability": {"enum": ["descriptive", "scenario", "probability"]},
    "mode": {"enum": ["live_snapshot", "reconstructed"]},
    "cutoff": {"type": "string", "format": "date-time"},
    "generated_at": {"type": "string", "format": "date-time"},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fact_revision", "pool_version", "source_url", "sha256", "locator", "published_at", "observed_at", "review_id"],
        "properties": {
          "fact_revision": {"type": "string", "minLength": 1},
          "pool_version": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "locator": {"type": "string", "minLength": 1},
          "published_at": {"type": "string", "format": "date-time"},
          "observed_at": {"type": "string", "format": "date-time"},
          "review_id": {"type": "string", "minLength": 1},
          "publication_proof": {"type": "string", "minLength": 1}
        }
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["pool_consistency", "evidence_review", "snapshot_integrity"],
      "properties": {
        "pool_consistency": {"$ref": "#/$defs/check"},
        "evidence_review": {"$ref": "#/$defs/check"},
        "snapshot_integrity": {"$ref": "#/$defs/check"},
        "scenario_sensitivity": {"$ref": "#/$defs/check"},
        "temporal_validation": {"$ref": "#/$defs/check"},
        "calibration": {"$ref": "#/$defs/check"},
        "applicability": {"$ref": "#/$defs/check"}
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "report_ref"],
      "properties": {
        "status": {"enum": ["passed", "failed", "pending"]},
        "report_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
